"""
API client for The Odds API (traditional bookmakers).
"""

import requests
from datetime import datetime
from typing import List, Optional
from models import Event, Outcome
from config import Config


class OddsAPIClient:
    """Client for The Odds API to fetch traditional bookmaker odds."""

    def __init__(self, api_key: str):
        """
        Initialize the Odds API client.

        Args:
            api_key: The Odds API key
        """
        self.api_key = api_key
        self.base_url = Config.ODDS_API_BASE_URL
        self.session = requests.Session()

    def get_sports(self) -> List[dict]:
        """Fetch available sports."""
        url = f"{self.base_url}/sports"
        params = {"apiKey": self.api_key}

        try:
            response = self.session.get(url, params=params, timeout=10)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            print(f"Error fetching sports: {e}")
            return []

    def get_odds(
        self,
        sport: str = "upcoming",
        regions: str = "uk",
        markets: str = "h2h",
        odds_format: str = "decimal",
        min_hours_ahead: int = 0,  # Minimum hours ahead (0 = include events starting now)
    ) -> List[Event]:
        """
        Fetch odds for a specific sport.

        Args:
            sport: Sport key (e.g., 'soccer_epl', 'upcoming')
            regions: Bookmaker regions (e.g., 'uk', 'us')
            markets: Market types (e.g., 'h2h', 'spreads', 'outrights' for tournament winners)
            odds_format: Format for odds (decimal, american)
            min_hours_ahead: Minimum hours ahead to include (0 = all events)

        Returns:
            List of Event objects
        """
        from datetime import datetime, timedelta, timezone

        url = f"{self.base_url}/sports/{sport}/odds"

        params = {
            "apiKey": self.api_key,
            "regions": regions,
            "markets": markets,
            "oddsFormat": odds_format,
        }

        try:
            response = self.session.get(url, params=params, timeout=10)
            response.raise_for_status()
            data = response.json()

            events = self._parse_events(data, markets)

            # Filter events by minimum hours ahead
            if min_hours_ahead > 0:
                now = datetime.now(timezone.utc)
                start_time = now + timedelta(hours=min_hours_ahead)

                filtered_events = [
                    event for event in events if event.commence_time >= start_time
                ]

                print(
                    f"[ODDS API] Found {len(data)} total events, {len(filtered_events)} starting in {min_hours_ahead}+ hours"
                )
                return filtered_events
            else:
                print(f"[ODDS API] Found {len(data)} events (no time filter)")
                return events
        except requests.exceptions.RequestException as e:
            print(f"Error fetching odds for {sport}: {e}")
            return []

    def _parse_events(self, data: List[dict], market_type: str = "h2h") -> List[Event]:
        """Parse API response into Event objects."""
        events = []

        for event_data in data:
            try:
                outcomes = []

                # Parse bookmakers and their odds
                for bookmaker in event_data.get("bookmakers", []):
                    bookmaker_name = bookmaker.get("title", "Unknown")
                    last_update = datetime.fromisoformat(
                        bookmaker.get("last_update", "").replace("Z", "+00:00")
                    )

                    for market in bookmaker.get("markets", []):
                        # Handle both h2h and outrights (tournament winners)
                        if market.get("key") in ["h2h", "outrights"]:
                            for outcome_data in market.get("outcomes", []):
                                outcome = Outcome(
                                    name=outcome_data.get("name", ""),
                                    price=float(outcome_data.get("price", 0)),
                                    bookmaker=bookmaker_name,
                                    last_update=last_update,
                                )
                                outcomes.append(outcome)

                if outcomes:
                    # For outrights, use the market description instead of home/away teams
                    if market_type == "outrights":
                        event = Event(
                            id=event_data.get("id", ""),
                            sport=event_data.get("sport_title", ""),
                            commence_time=(
                                datetime.fromisoformat(
                                    event_data.get("commence_time", "").replace(
                                        "Z", "+00:00"
                                    )
                                )
                                if event_data.get("commence_time")
                                else datetime.now()
                            ),
                            home_team="Tournament Winner",
                            away_team=event_data.get(
                                "sport_title", "Unknown Tournament"
                            ),
                            outcomes=outcomes,
                            description=event_data.get("id", "")
                            .replace("_", " ")
                            .title(),
                        )
                    else:
                        event = Event(
                            id=event_data.get("id", ""),
                            sport=event_data.get("sport_title", ""),
                            commence_time=datetime.fromisoformat(
                                event_data.get("commence_time", "").replace(
                                    "Z", "+00:00"
                                )
                            ),
                            home_team=event_data.get("home_team", ""),
                            away_team=event_data.get("away_team", ""),
                            outcomes=outcomes,
                        )
                    events.append(event)
            except (ValueError, KeyError) as e:
                print(f"Error parsing event: {e}")
                continue

        return events

    def get_remaining_requests(self) -> Optional[int]:
        """Check remaining API requests quota."""
        # Make a lightweight request to check quota
        url = f"{self.base_url}/sports"
        params = {"apiKey": self.api_key}

        try:
            response = self.session.get(url, params=params, timeout=10)
            remaining = response.headers.get("x-requests-remaining")
            return int(remaining) if remaining else None
        except (requests.exceptions.RequestException, ValueError):
            return None
